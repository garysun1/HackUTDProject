# Laptop-side tooling only (MCP server, web view dev, fixture replay). The Spacetime module
# reads its secrets from its own config table (set via an admin reducer), never from the repo.
# Cloud agent sessions: keys are proxy-injected; set the variable to "proxy-injected".

# Spacetime (Maincloud)
SPACETIME_DB_NAME=
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_WS=wss://maincloud.spacetimedb.com
INGEST_TOKEN=change-me

# NVIDIA Nemotron (OpenAI-compatible)
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NEMOTRON_AGENT_MODEL=nemotron-3.5-lightning-30b-a3b
NEMOTRON_VL_MODEL=nemotron-3.5-super-vl-120b-a12b

# Azure (resource hackutd-wm-garysun, East US). Key from the portal > Keys and Endpoint.
AZURE_AI_KEY=
AZURE_OPENAI_ENDPOINT=https://hackutd-wm-garysun.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_VLM_DEPLOYMENT=vlm-gpt-4o
AZURE_OPENAI_AGENT_DEPLOYMENT=agent-gpt-5
AZURE_AI_SERVICES_ENDPOINT=https://hackutd-wm-garysun.cognitiveservices.azure.com/
